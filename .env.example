# Plantilla de variables de entorno para desarrollo local.
# Copia este archivo como `.env` en la raíz del repo:
#   cp .env.example .env
# Luego reemplaza los valores CHANGE_ME con los reales.
# El archivo `.env` está ignorado por git, así que no sube al repo.

# ----------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------
# Para desarrollo local usamos la BD espejo de producción (no la fuente original).
# Las credenciales reales las tiene Juan — pídelas por WhatsApp / mensaje directo.
# El schema de las vistas siempre es `db_packgps`; si apuntás a otra DB default,
# las queries en IRepositoryContract están calificadas para seguir resolviendo.
DB_URL=jdbc:mysql://HOST:3306/db_packgps?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ----------------------------------------------------------------------
# Seguridad
# ----------------------------------------------------------------------
# Token compartido que protege todos los endpoints (header X-API-Key).
# Para local podés usar cualquier string; en producción debe ser >=32 chars random.
# Esta key tiene que coincidir con la que pegás en el modal de login del dashboard.
app.api-key=local-dev-key-1234

# ----------------------------------------------------------------------
# JPA / Hibernate
# ----------------------------------------------------------------------
# `none` evita que Hibernate intente crear/alterar tablas en la BD espejo.
# Usa `update` solo si conectás a una BD propia de desarrollo donde quieras
# que se auto-creen las tablas `notification` y `error_notification`.
spring.jpa.hibernate.ddl-auto=none

# ----------------------------------------------------------------------
# CORS (opcional)
# ----------------------------------------------------------------------
# Por defecto el backend permite cualquier origen (*). Para local con frontend
# en http://localhost:5173 no hace falta tocar nada.
# En producción, setear al dominio exacto del frontend, p. ej.:
# app.cors.allowed-origins=https://fronted-2rrf.onrender.com
